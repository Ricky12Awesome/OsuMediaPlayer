{
  "name": "osu-media-player",
  "version": "0.0.9",
  "private": true,
  "description": "A osu!lazer music player",
  "author": "Ricky12Awesome",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node tests/electron.e2e.mjs",
    "test:streaming": "npm run build && node --import tsx tests/library-streaming.e2e.ts",
    "format": "prettier --write src tests scripts *.json *.ts README.md",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "realm": "^20.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "dev.osumediaplayer.app",
    "productName": "OsuMediaPlayer",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/realm/**/*",
      "package.json"
    ],
    "linux": {
      "artifactName": "${productName}-${os}-x64.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null
    },
    "asarUnpack": [
      "node_modules/realm/**/*"
    ]
  },
  "allowScripts": {
    "realm@20.2.0": true
  }
}
